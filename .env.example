APP_NAME=Research
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The key, the Ollama connection and the research defaults below are all
# editable on the Settings page, which is the only route a packaged app has.
# Anything set here wins while nothing has been saved there, so leave them
# empty unless you are working from a checkout.
TABSTACK_API_KEY=
TABSTACK_BASE_URL=https://api.tabstack.ai/v1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

RESEARCH_DEFAULT_MODE=fast
RESEARCH_DEFAULT_BUDGET=2000
RESEARCH_MAX_DEPTH=3

# Replay database/fixtures/*.sse instead of calling Tabstack. Costs no credits.
RESEARCH_OFFLINE=false

NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_ID=com.juststeveking.research
NATIVEPHP_APP_AUTHOR="Steve McDougall"
NATIVEPHP_APP_COPYRIGHT="Copyright © 2026 Steve McDougall"
NATIVEPHP_APP_DESCRIPTION="A local-first research workspace"
NATIVEPHP_APP_WEBSITE=https://github.com/juststeveking/research

# Releases are published to GitHub by .github/workflows/build.yml; the built
# app checks the same repo for updates. GITHUB_* keys are stripped from the
# bundled .env at build time (see nativephp.cleanup_env_keys).
NATIVEPHP_UPDATER_ENABLED=true
NATIVEPHP_UPDATER_PROVIDER=github
GITHUB_OWNER=JustSteveKing
GITHUB_REPO=research
GITHUB_TOKEN=
